<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- 覆盖机器级 NuGet 源，避免不可达镜像导致还原失败 -->
    <clear />
    <!-- 国内镜像（优先） -->
    <add key="tencent" value="https://mirrors.cloud.tencent.com/nuget/" />
    <!-- 官方源（备用） -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>

